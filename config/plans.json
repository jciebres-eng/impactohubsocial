{
  "version": "plans@1.0",
  "_note": "Preços null = a definir pelo proprietário (exibido como 'sob consulta'). Cobrança real exige BILLING_PROVIDER configurado. Nenhum plano altera match, elegibilidade, ordenação ou posição de prestador.",
  "invariants": [
    "no_plan_affects_match",
    "no_plan_affects_provider_rank",
    "downgrade_never_deletes_data"
  ],
  "downgrade_grace_days": 60,
  "flags": {
    "premium_osc": {
      "default": true,
      "description": "Permite contratar planos pagos de OSC (buscas salvas, rastreio e alertas de editais)"
    },
    "premium_provider": {
      "default": false,
      "description": "Permite contratar plano pago de prestador"
    },
    "billing_live": {
      "default": false,
      "description": "Indica que a cobrança real foi homologada (exibe aviso de sandbox quando falso)"
    },
    "public_directory_providers": {
      "default": true,
      "description": "Diretório de profissionais parceiros visível para organizações"
    }
  },
  "plans": {
    "osc_basic": {
      "role": "osc",
      "name": "OSC Essencial",
      "price_cents": 0,
      "interval": "month",
      "limits": {
        "active_projects": 2,
        "ai_requests_month": 20,
        "storage_mb": 500,
        "seats": 3,
        "saved_searches": 0
      },
      "features": [
