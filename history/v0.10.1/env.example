# =====================================================================================
# Plataforma Impacto — variáveis de ambiente (copie para .env e preencha; NUNCA versione o .env)
# Gere segredos com:  cd backend && python3 -m impacto.cli gen-secrets
# =====================================================================================
IMPACTO_ENV=production                 # development | test | staging | production
PUBLIC_BASE_URL=https://SEU-DOMINIO    # https obrigatório em staging/production
PORT=8080
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true               # true SOMENTE atrás de proxy reverso confiável (X-Forwarded-For)
CORS_ORIGINS=                          # app nativo: capacitor://localhost,https://localhost

# Banco (papel da aplicação, SEM bypass de RLS) e papel de migrations (dono do schema)
DATABASE_URL=postgresql://impacto_app:SENHA@HOST:5432/impacto?sslmode=require
MIGRATION_DATABASE_URL=postgresql://impacto_owner:SENHA@HOST:5432/impacto?sslmode=require
DATABASE_POOL_SIZE=10

# Segredos (mín. 32 caracteres; obrigatórios em staging/production)
SECRET_KEY=
VOUCHER_HMAC_KEY=
FIELD_ENCRYPTION_KEY=                  # chave Fernet; para rotação: "nova,antiga"
METRICS_TOKEN=                         # Bearer para /metrics (vazio em produção = /metrics desativado)

# Sessão
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=true
REQUIRE_MFA_FOR_ADMINS=true
REQUIRE_EMAIL_VERIFICATION=true

# E-mail transacional (obrigatório smtp em staging/production)
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Impacto <no-reply@SEU-DOMINIO>

# Arquivos: local (volume privado) ou s3 (S3/MinIO/R2)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT=                           # vazio = AWS (https://s3.<região>.amazonaws.com)
S3_REGION=sa-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=15728640

# Antivírus (sem ele, arquivos ficam em quarentena e downloads são bloqueados em produção)
ANTIVIRUS_PROVIDER=clamd
CLAMD_HOST=clamav
CLAMD_PORT=3310
ALLOW_UNSCANNED_DOWNLOADS=false

# Cobrança da plataforma (nunca de aportes): none | stripe | manual  (sandbox proibido em production)
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OSC_PREMIUM=              # price_... por plano (STRIPE_PRICE_<PLAN_KEY>)
STRIPE_PRICE_COMPANY_PREMIUM=

# IA: local (padrão, offline) | anthropic | openai_compatible | disabled
AI_PROVIDER=local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=12000

# SSO corporativo (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://SEU-DOMINIO/v1/auth/oidc/callback

# Compliance (fontes externas; sem elas as verificações ficam "não configuradas", nunca "aprovadas")
CNPJ_LOOKUP_URL=                       # ex.: https://brasilapi.com.br/api/cnpj/v1/{cnpj}  [VALIDAR termos de uso]
PORTAL_TRANSPARENCIA_API_KEY=          # CEIS/CNEP

# Worker
JOBS_INTERVAL_SECONDS=900

# Somente desenvolvimento/teste (bloqueados em staging/production pela validação de configuração)
IMPACTO_SEED_DEMO=false
DEMO_PASSWORD=
PASSWORD_SCRYPT_N=131072
RATE_LIMIT_MULTIPLIER=1

# Docker Compose (infra/compose)
POSTGRES_SUPERUSER_PASSWORD=
IMPACTO_OWNER_PASSWORD=
IMPACTO_APP_PASSWORD=
