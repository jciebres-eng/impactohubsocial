{
  "name": "impacto-web",
  "version": "0.24.2",
  "private": true,
  "type": "module",
  "description": "Plataforma Impacto — aplicação web/PWA (React + TypeScript, empacotada com esbuild)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "cd ../backend && python3 -m unittest tests.test_e2e_web"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/android": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/preferences": "7.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
