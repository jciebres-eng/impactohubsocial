{
  "name": "impacto-web",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Plataforma Impacto — aplicação web/PWA (React + TypeScript, empacotada com esbuild)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "cd ../backend && python3 -m unittest tests.test_e2e_web"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "engines": { "node": ">=20" }
}
